{
    "name": "rashod-next",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "bun --bun next dev --hostname 0.0.0.0",
        "build": "bun --bun next build",
        "start": "bun --bun run scripts/start-lan-http.ts",
        "start:lan-http": "bun --bun run scripts/start-lan-http.ts",
        "start:secure": "bun --bun next start --hostname 127.0.0.1",
        "lint": "eslint",
        "typecheck": "tsc --noEmit --incremental false",
        "test": "vitest run",
        "test:unit": "vitest run --project unit",
        "test:component": "vitest run --project component",
        "test:integration": "vitest run --project integration",
        "test:coverage": "vitest run --project unit --project component --coverage",
        "test:e2e": "bun run scripts/run-e2e.ts",
        "test:e2e:full": "bun run scripts/run-e2e.ts --full",
        "test:db:reset": "bun run scripts/reset-test-db.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "bun --env-file=.env --bun run src/server/db/migrate-postgres.ts",
        "auth:create-admin": "bun --env-file=.env --bun run src/server/auth/create-admin.ts",
        "bundle:offline": "bun run scripts/bundle-offline.ts"
    },
    "dependencies": {
        "@phosphor-icons/react": "^2.1.10",
        "clsx": "^2.1.1",
        "drizzle-orm": "^0.45.2",
        "next": "16.2.10",
        "postgres": "^3.4.9",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.12.1",
        "@playwright/test": "^1.61.1",
        "@tailwindcss/postcss": "^4.3.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^6.0.3",
        "@vitest/coverage-v8": "4.1.9",
        "bun-types": "^1.3.14",
        "drizzle-kit": "^0.31.10",
        "eslint": "^9",
        "eslint-config-next": "16.2.10",
        "jsdom": "^29.1.1",
        "tailwindcss": "^4.3.2",
        "typescript": "^5",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^4.1.9"
    },
    "ignoreScripts": [
        "sharp",
        "unrs-resolver"
    ],
    "trustedDependencies": [
        "sharp",
        "unrs-resolver"
    ]
}
